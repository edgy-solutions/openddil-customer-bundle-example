# The sibling repositories the overlay's CI pins, written into its conformance.yml by init-overlay.
# Each is a full commit SHA, so a change in a sibling cannot turn the overlay's CI red or green
# on its own. Move a pin on purpose, in a commit that says why.

# openddil-helm: origin/master as of 2026-11-10 (the chart the values-chain and twin checks render).
HELM_REF=8bbcb9a2fe7a80494c248d4e208511c839ccfdb5

# openddil-demo: origin/master as of 2026-11-10 (the egress service's own config loaders).
DEMO_REF=59b5bf78544ab763371516b2bdb79acb3c9a77b5

# openddil-contracts: the units-table head, which carries the shared unit table the harness
# imports. Move to the default branch once the open PRs merge.
CONTRACTS_REF=e63f9007aacbe952282b4e168038fd1c7e880e9c

# openddil-tactical-agents: the algorithms-ports head, the same harness the starter kit ships (its
# runtime has the posture roles the template unit reads; units-celsius does not).
# Move to the default branch once the open PRs merge.
TA_REF=dd52482bf1a6a738145f1f1250661ca29786f44a

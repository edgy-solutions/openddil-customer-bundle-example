# =============================================================================
# openddil-customer-bundle-example — .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
env/
venv/
ENV/

# Distribution / Build
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
sdist/
wheels/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local-only IDE / MCP config (not for OSS distribution)
.mcp.json
.claude/
tests/bloblang/.bin/

# Terrain tiles are build output: tools/terrain-twin regenerates them byte for
# byte (content-hashed directory), so only the generator and water.json are kept.
deployment-overlay/terrain/*/dem/
deployment-overlay/terrain/*/imagery/
deployment-overlay/terrain/*/patch-imagery/
